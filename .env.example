# CosmicWatch Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Open-Weight LLM Service (Gemma / Qwen integration)
# Options: "local_heuristic" | "ollama" | "huggingface" | "gemma_openweight"
LLM_PROVIDER=local_heuristic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
HF_API_TOKEN=
HF_MODEL_REPO=google/gemma-2-9b-it

# Data & Paths
DATA_DIR=data
MODELS_DIR=ml/models_saved
CONFIG_FILE=ml/config/scoring_weights.yaml

# Demo & Random Seed
SEED=42
DEMO_MODE=true
